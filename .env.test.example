# Copy to .env.test and use credentials restricted to bookstore_test.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3307
APP_DB_NAME=bookstore_test
APP_DB_USER=bookstore_test
APP_DB_PASSWORD=replace_with_local_test_password
# URL-encode special characters in the username and password in this URL.
BOOKSTORE_TEST_DATABASE_URL=mysql+pymysql://bookstore_test:replace_with_local_test_password@127.0.0.1:3307/bookstore_test
